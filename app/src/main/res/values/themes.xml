<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GiftLedger" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorSecondary">@color/luxury_gold</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/rice_white</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Splash 主题 -->
    <style name="Theme.GiftLedger.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="android:windowBackground">@color/rice_white</item>
        <item name="android:statusBarColor">@color/rice_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
